# Copy these values into your STS Run Configuration environment variables.
# Never commit a real database password to this file or application.yml.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/disasterreport?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-local-mysql-password
ML_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-development-secret
